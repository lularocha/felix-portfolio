---

<section id="contact" class="fade-in px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="mb-6 text-3xl font-bold sm:text-4xl">
      Get in <span class="text-accent">Touch</span>
    </h2>
    <p class="mb-10 text-lg leading-relaxed text-text-secondary">
      Have a project in mind or just want to say hello?
      I'd love to hear from you.
    </p>
    <div class="flex items-center justify-center gap-4">
      <a
        href="https://x.com/lularocha"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
      >
        <!-- Twitter / X icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        Follow on X
      </a>
      <a
        href="mailto:hello@lularocha.dev"
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 text-sm font-medium text-text-secondary transition-colors hover:border-text-secondary hover:text-text-primary"
      >
        <!-- Email icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Send Email
      </a>
    </div>
  </div>
</section>
