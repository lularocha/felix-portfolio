---

---

<section class="relative flex min-h-screen items-center justify-center px-6">
  <div class="mx-auto max-w-4xl text-center">
    <p class="mb-4 text-sm font-medium tracking-widest text-accent uppercase">
      Designer &amp; Developer
    </p>
    <h1 class="mb-6 text-5xl font-bold leading-tight tracking-tight sm:text-7xl lg:text-8xl">
      Hi, I'm <span class="whitespace-nowrap text-accent">Lula Rocha</span>
    </h1>
    <p class="mx-auto max-w-2xl text-lg leading-relaxed text-text-secondary sm:text-xl">
      I craft modern digital experiences with clean code and thoughtful design.
      Turning ideas into polished, performant web applications.
    </p>
    <div class="mt-10 flex items-center justify-center gap-4">
      <a
        href="#projects"
        class="rounded-lg bg-accent px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
      >
        View My Work
      </a>
      <a
        href="#contact"
        class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-text-secondary transition-colors hover:border-text-secondary hover:text-text-primary"
      >
        Get in Touch
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
