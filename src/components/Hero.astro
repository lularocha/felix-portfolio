---

---

<section class="relative flex min-h-screen items-center justify-center px-6 bg-cover bg-center bg-no-repeat" style="background-image: url('/images/hero/lularocha.jpg');">
  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-gradient-to-b from-bg/50 via-bg/60 to-bg/80"></div>

  <div class="relative z-10 mx-auto max-w-4xl lg:max-w-6xl text-left">
    <p class="mb-4 text-sm font-medium tracking-widest text-accent uppercase">
      Designer &amp; Developer
    </p>
    <h1 class="mb-6 text-5xl font-medium leading-tight tracking-tight sm:text-7xl lg:text-8xl">
      Hi, I'm <span class="whitespace-nowrap">Lula Rocha</span>
    </h1>
    <p class="max-w-4xl text-lg leading-relaxed text-text-secondary sm:text-xl">
      I craft digital tools with clean code and thoughtful design.
    </p>
    <div class="mt-10 flex items-center justify-start gap-4">
      <a
        href="#projects"
        class="btn-text rounded-lg bg-accent px-6 py-3 font-medium text-bg transition-colors hover:bg-accent-hover"
      >
        View My Work
      </a>
      <a
        href="#contact"
        class="btn-text rounded-lg bg-[#222] px-6 py-3 font-medium text-text-secondary transition-colors hover:bg-[#000]"
      >
        Get in Touch
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>
