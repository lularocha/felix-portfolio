---
interface Props {
  title: string;
  description: string;
  tags: string[];
  url?: string;
  image?: string;
}

const { title, description, tags, url = "#", image } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group block rounded-xl p-2 transition-all duration-300 sm:hover:-translate-y-1 sm:hover:bg-bg-card-hover sm:hover:shadow-lg sm:hover:shadow-accent/5"
>
  <div class="px-0 pt-0 sm:px-4 sm:pt-4">
    {image ? (
      <div class="aspect-video w-full overflow-hidden rounded-lg bg-border">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 sm:group-hover:scale-105"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="aspect-video w-full rounded-lg bg-gradient-to-br from-accent/10 to-accent/5 flex items-center justify-center">
        <span class="text-4xl text-accent/30">{title.charAt(0)}</span>
      </div>
    )}
  </div>
  <div class="px-0 py-4 sm:p-4">
    <h3 class="mb-2 text-2xl sm:text-lg font-semibold text-text-primary sm:group-hover:text-accent transition-colors">
      {title}
    </h3>
    <p class="mb-3 text-lg leading-relaxed text-text-secondary sm:text-sm">
      {description}
    </p>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full bg-accent/10 px-3 py-1 text-base font-medium text-accent sm:text-xs">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>
