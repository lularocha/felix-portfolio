---
interface Props {
  title: string;
  description: string;
  tags: string[];
  url?: string;
  image?: string;
}

const { title, description, tags, url = "#", image } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group block rounded-xl bg-bg-card p-2 transition-all duration-300 hover:-translate-y-1 hover:bg-bg-card-hover hover:shadow-lg hover:shadow-accent/5"
>
  {image ? (
    <div class="aspect-video w-full overflow-hidden rounded-lg bg-border">
      <img
        src={image}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="aspect-video w-full rounded-lg bg-gradient-to-br from-accent/10 to-accent/5 flex items-center justify-center">
      <span class="text-4xl text-accent/30">{title.charAt(0)}</span>
    </div>
  )}
  <div class="p-4">
    <h3 class="mb-2 text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
      {title}
    </h3>
    <p class="mb-3 text-sm leading-relaxed text-text-secondary">
      {description}
    </p>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent">
          {tag}
        </span>
      ))}
    </div>
  </div>
</a>
