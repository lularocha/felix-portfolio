---

---

<section id="about" class="fade-in px-6 py-24">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-16 text-center text-3xl font-bold sm:text-4xl">
      About <span class="text-accent">Me</span>
    </h2>

    <div class="grid items-center gap-12 md:grid-cols-2">
      <!-- Avatar placeholder -->
      <div class="flex justify-center">
        <div class="h-64 w-64 overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-accent/20 to-accent/5 flex items-center justify-center">
          <span class="text-7xl text-accent/40">LR</span>
        </div>
      </div>

      <!-- Bio -->
      <div>
        <p class="mb-4 text-lg leading-relaxed text-text-secondary">
          I'm Lula Rocha, a developer and designer passionate about building
          clean, performant web experiences. I love working at the
          intersection of design and engineering, where aesthetics meet
          functionality.
        </p>
        <p class="mb-6 text-lg leading-relaxed text-text-secondary">
          With a focus on modern front-end technologies, I build products
          that are both beautiful and accessible. When I'm not coding,
          you can find me exploring new design trends or tinkering with
          side projects.
        </p>

        <!-- Skills -->
        <div class="flex flex-wrap gap-2">
          {["JavaScript", "TypeScript", "React", "Astro", "Tailwind CSS", "Node.js", "Figma", "Git"].map((skill) => (
            <span class="rounded-full border border-border px-4 py-1.5 text-sm text-text-secondary">
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
